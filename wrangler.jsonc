{
	// Deploying the prerendered site as a Worker serving static assets.
	//
	// There is no `main`: every page is prerendered by adapter-static, so there
	// is no server code to run and no Worker script to invoke. Requests are
	// answered from `build/` directly, which is also why this costs nothing —
	// only Worker invocations are billable, and there are none.
	//
	// `_redirects` and `_headers` in `static/` are read here exactly as they are
	// on Pages, so the resume redirect and the security headers carry over
	// unchanged.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "henrykhoanguyen-com",
	"compatibility_date": "2026-08-04",
	"assets": {
		"directory": "./build",

		// Serve build/404.html for anything that does not match a file, with a
		// 404 status. Without this, an unknown path falls back to index.html and
		// the visitor gets the home page — boot sequence and all — instead of
		// being told the path does not exist.
		"not_found_handling": "404-page"
	}
}
